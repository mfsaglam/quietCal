    "onboarding.welcome.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log a meal, get an instant estimate, watch one ring. No macros, no streaks, no noise."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir öğün kaydedin, anında tahmin alın, tek halkayı izleyin. Makro yok, seri yok, karmaşa yok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeit erfassen, sofortige Schätzung erhalten, einen Ring im Blick behalten. Keine Makros, keine Serien, kein Ballast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una comida, obtén una estimación al instante y consulta un solo anillo. Sin macros, sin rachas, sin ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un repas, obtenez une estimation instantanée et suivez un seul anneau. Pas de macros, pas de séries, pas de bruit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un pasto, ottieni una stima immediata e controlla un solo anello. Niente macro, serie o confusione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registe uma refeição, obtenha uma estimativa imediata e acompanhe um único anel. Sem macros, séries ou ruído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите приём пищи, получите мгновенную оценку и следите за одним кольцом. Без БЖУ, серий и лишнего шума."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل وجبة واحصل على تقدير فوري وتابع حلقة واحدة. بلا عناصر كبرى، ولا سلاسل، ولا ضوضاء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भोजन लॉग करें, तुरंत अनुमान पाएँ और एक रिंग देखें। न मैक्रो, न स्ट्रीक, न शोर।"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录餐食、立即获得估算并关注一个圆环。无需宏量数据、连续打卡或其他干扰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事を記録してすぐに推定。見るのは1つのリングだけ。栄養素も連続記録も余計な情報もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사를 기록하고 즉시 추정한 후 하나의 링만 확인하세요. 매크로도, 연속 기록도, 소음도 없습니다."
          }
        }
      }
    },
