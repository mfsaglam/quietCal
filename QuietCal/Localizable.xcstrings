        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ़्त संस्करण पिछले %@ दिन दिखाता है। QuietCal Pro से अपने सभी रिकॉर्ड किए गए दिन अनलॉक करें।"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
