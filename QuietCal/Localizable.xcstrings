      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free shows the last %@ days. Unlock every day you've tracked with QuietCal Pro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz sürüm son %@ günü gösterir. QuietCal Pro ile kaydettiğiniz tüm günlerin kilidini açın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenlose Version zeigt die letzten %@ Tage. Mit QuietCal Pro kannst du alle erfassten Tage freischalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión gratuita muestra los últimos %@ días. Desbloquea todos los días registrados con QuietCal Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite affiche les %@ derniers jours. Débloquez tous les jours enregistrés avec QuietCal Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione gratuita mostra gli ultimi %@ giorni. Sblocca tutti i giorni registrati con QuietCal Pro."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão gratuita mostra os últimos %@ dias. Desbloqueie todos os dias registados com o QuietCal Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В бесплатной версии доступны последние %@ дней. Откройте все записанные дни с QuietCal Pro."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الإصدار المجاني آخر %@ أيام. افتح كل الأيام التي سجّلتها باستخدام QuietCal Pro."
